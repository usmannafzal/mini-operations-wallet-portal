# --- Application ---
# Port the NestJS HTTP server listens on.
PORT=3001

# --- Database (discrete connection vars) ---
# Used by both the app (TypeOrmModule in app.module.ts) and the TypeORM
# migration CLI (src/database/data-source.ts).
#
# For running the app locally (outside Docker) against the compose Postgres, keep
# DB_HOST=localhost. When the app runs INSIDE docker-compose it connects to the
# Postgres container over the compose network, so there DB_HOST is "db" (the compose
# service already sets this override for you).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mini_operations_wallet_portal
