# --- Application ---
# Port the NestJS HTTP server listens on.
PORT=3000

# --- Database ---
# Full Postgres connection string used by both the app and the TypeORM migration CLI.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
#
# When running the app locally (outside Docker) against the compose Postgres, use localhost:
#   postgres://postgres:postgres@localhost:5432/wallet
# When running the app INSIDE docker-compose, the host is the compose service name "db":
#   postgres://postgres:postgres@db:5432/wallet
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wallet

# --- Postgres container (docker-compose) ---
# These are consumed by the "db" service in docker-compose.yml to initialise Postgres.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet
