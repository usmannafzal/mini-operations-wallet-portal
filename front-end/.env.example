# Browser-facing API prefix. Prefer `/backend` so Next.js can rewrite/proxy
# to the Nest service (see next.config.ts + API_PROXY_TARGET).
NEXT_PUBLIC_API_URL=/backend

# Where Next.js proxies `/backend/*` (server-side only — not exposed to the browser).
# Local yarn dev: http://localhost:3001
# Docker Compose:  http://app:3001  (compose service name)
API_PROXY_TARGET=http://localhost:3001
